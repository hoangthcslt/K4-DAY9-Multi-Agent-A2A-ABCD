# Copy this file to .env and fill only the provider you intend to use.
# Set LLM_REQUIRED=true when every logical agent must complete a real model call.

LLM_ENABLED=true
LLM_REQUIRED=true

# Provider options:
# - ollama: local, no API key required (recommended for the lab)
# - openrouter: optional free-tier account; model availability/limits vary
# - groq: optional free developer tier; model availability/limits vary
# - huggingface: optional Hugging Face token for an inference endpoint
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=128
# Groq's free limit is commonly 30 requests/minute for this model; 2.1s keeps
# the seven-agent run below that ceiling. Lower it only if your account allows.
LLM_MIN_INTERVAL_SECONDS=2.5

# Provider credentials. Keep these empty until you have created the key.
# Never commit .env.
OPENROUTER_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# Optional OpenAI-compatible headers used by some hosted providers.
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=olist-multi-agent

# Model names. Use provider-compatible names if the provider does not use
# Hugging Face IDs. All selected models must be <= 10B parameters.
MODEL_COORDINATOR=llama-3.1-8b-instant
MODEL_CUSTOMER=llama-3.1-8b-instant
MODEL_ORDER_PRODUCT=llama-3.1-8b-instant
MODEL_PAYMENT=llama-3.1-8b-instant
MODEL_DELIVERY=llama-3.1-8b-instant
MODEL_POLICY=llama-3.1-8b-instant
MODEL_VERIFIER=llama-3.1-8b-instant

# Repository paths.
DATA_DIR=data
INPUT_DIR=input
OUTPUT_DIR=output
LOG_DIR=logging
TRACE_PATH=logging/trace.jsonl
METADATA_PATH=logging/metadata.json
MAX_AGENT_RETRIES=4
